PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datve_db
DB_USERNAME=datve_user
DB_PASSWORD=local_dev_only_12345

# JWT: bắt buộc, tối thiểu 32 ký tự. Tạo bằng: openssl rand -hex 32
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN_SECONDS=86400

# CORS: danh sách origin của frontend, ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Đặt true khi chạy sau reverse proxy (để rate limit theo IP thật)
TRUST_PROXY=false

# Rate limit: số request tối đa mỗi phút cho mỗi IP
THROTTLE_LIMIT=300

# Cho phép client giả lập thanh toán thất bại (chỉ nên bật khi dev)
PAYMENT_ALLOW_SIMULATION=true
PAYMENT_MOCK_DELAY_MS=400

# Bật/tắt job nền dọn booking hết hạn
SCHEDULER_ENABLED=true

# Swagger UI tại /api/docs (mặc định tắt khi NODE_ENV=production)
SWAGGER_ENABLED=true
